# Скопируй этот файл в .env и впиши значения. Файл .env в git не попадает.

# Токен бота из @BotFather. Без него запустится только сайт.
TG_BOT_TOKEN=

# Ключ Claude API с platform.claude.com (платный). Можно оставить пустым:
# тогда Venti бесплатно отвечает готовыми ответами на частые вопросы.
ANTHROPIC_API_KEY=

# Твой Telegram id для /stats и /sync_commands. Бот покажет его в ответ на /stats.
TG_ADMIN_IDS=
